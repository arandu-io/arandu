# Copy to .env and fill in. Never commit .env.

APP_NAME=arandu-app
APP_ENV=dev

# Generate with: aru key:generate
APP_KEY=

HTTP_ADDR=:8080
LOG_LEVEL=info

# Database. SQLite is the default: a file, no server, nothing to install.
# Switch to pgsql or mysql and fill in the block below.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Used by pgsql and mysql only.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# A managed platform usually hands out one URL. When set, it wins over
# everything above.
DATABASE_URL=

# Optional. Only needed once sessions or rate limiting run on more than one pod.
REDIS_URL=

# The tenant every login belongs to. `aru db:seed` prints one when it has to
# generate it. A multi-tenant application resolves this from the host name
# instead; see auth.TenantResolver.
ARANDU_TENANT_ID=

# Read by the AdminSeeder only, to create the first administrator. Remove them
# once the user exists: there is no reason to keep a password in .env.
ARANDU_ADMIN_EMAIL=
ARANDU_ADMIN_PASSWORD=

# Enables the request Collector outside development, for requests carrying this
# value in X-Arandu-Trace. Leave empty in production unless you are tracing.
ARANDU_TRACING_SECRET=

# Target of the "open in editor" links on the error page: vscode, cursor, goland, zed.
ARANDU_EDITOR=vscode
