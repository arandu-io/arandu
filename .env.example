# Copy to .env and fill in. Never commit .env.

APP_NAME=arandu-app
APP_ENV=dev

# Generate with: aru key:generate
APP_KEY=

HTTP_ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://arandu:arandu@localhost:5432/arandu?sslmode=disable

# Optional. Only needed once sessions or rate limiting run on more than one pod.
REDIS_URL=

# The tenant every login belongs to. `aru seed:admin` prints one when it has to
# generate it. A multi-tenant application resolves this from the host name
# instead; see auth.TenantResolver.
ARANDU_TENANT_ID=

# Read by `aru seed:admin` only, to create the first administrator. Remove them
# once the user exists: there is no reason to keep a password in .env.
ARANDU_ADMIN_EMAIL=
ARANDU_ADMIN_PASSWORD=

# Seconds.
SESSION_TTL=43200
CSRF_TTL=7200

# Enables the request Collector outside development, for requests that carry this
# value in X-Arandu-Trace. Leave empty in production unless you are tracing.
ARANDU_TRACING_SECRET=

# Target of the "open in editor" links on the error page: vscode, cursor, goland, zed.
ARANDU_EDITOR=vscode
