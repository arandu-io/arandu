# Copy to .env and fill in. Never commit .env.
#
# The sections below follow config/: one block per file, in the same order. A
# variable that is not read by any of those files is a variable nobody reads.

# --- config/app.go ---------------------------------------------------------
APP_NAME=arandu-app
APP_ENV=dev
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en

# Generate with: aru key:generate
APP_KEY=

HTTP_ADDR=:8080

# --- config/logging.go -----------------------------------------------------
LOG_LEVEL=info
# json or text. Text is the default in development, json everywhere else.
LOG_FORMAT=
# Drop one in N info records under load. Empty keeps all of them.
LOG_SAMPLING=

# --- config/database.go ----------------------------------------------------
# Where the database is, in one variable. SQLite is the default: a file, no
# server, nothing to install. Every managed platform hands out exactly this
# string, so moving between them is one line rather than six.
#
#   DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname
#   DATABASE_URL=mysql://user:password@127.0.0.1:3306/dbname
DATABASE_URL=sqlite://database/database.sqlite

# The pool, and it is commented out on purpose: leaving a variable out is how
# the adapter is asked for its own answer, and this file is copied into every
# deployment. Written out here, the three numbers below would be pinned in all
# of them -- the adapter's defaults would reach none, and raising one later
# would mean finding it in an .env nobody remembers writing.
#
# Uncomment one to override it. The numbers are examples of the shape and not
# the defaults: an example that repeats the default is one nobody can tell from
# a setting somebody chose.
#
# A value that is present and cannot be used stops the boot naming itself --
# unparseable, zero or negative. Zero is refused rather than read as "no limit",
# because there is no unbounded pool to ask for: the bound is what turns a
# traffic spike into a queue in this process instead of "too many connections"
# on the server.
#
# The lifetime is a count of seconds. It is what makes the pool replace a
# connection a managed database rotated behind a proxy without a request failing
# first. SQLite ignores the first one: it gets a single writer whatever is set.
#DB_MAX_OPEN_CONNS=50
#DB_MAX_IDLE_CONNS=10
#DB_CONN_MAX_LIFETIME=900


# --- config/auth.go --------------------------------------------------------
# The tenant every login belongs to. `aru db:seed` prints one when it has to
# generate it. A multi-tenant application resolves this from the host name
# instead; see auth.TenantResolver.
ARANDU_TENANT_ID=

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_RESET_TTL=3600

# Read by the AdminSeeder only, to create the first administrator. Remove them
# once the user exists: there is no reason to keep a password in .env.
ARANDU_ADMIN_EMAIL=
ARANDU_ADMIN_PASSWORD=

# --- config/session.go -----------------------------------------------------
# memory or kv. Memory is right for one instance and wrong for two: behind a
# load balancer, half the requests land on the replica that never saw the login.
SESSION_DRIVER=memory
SESSION_TTL=43200
SESSION_COOKIE=arandu_session
SESSION_PATH=/
SESSION_DOMAIN=
# Follows APP_ENV unless set. Never true in development: a Secure cookie does
# not reach a browser over http://localhost.
SESSION_SECURE=
CSRF_TTL=7200

# --- config/cache.go -------------------------------------------------------
CACHE_STORE=memory
CACHE_PREFIX=
CACHE_TTL=600

# The RESP endpoint, read by the cache and by the session store. Dragonfly,
# Redis, Valkey and KeyDB all speak it. Only needed once either of them runs on
# more than one pod.
#
# One URL rather than a host, a port, a password and a database number, for the
# reason MAIL_URL is one: a credential cannot be left behind in a variable the
# new endpoint does not read. The port defaults to 6379 and the path is the
# numbered database.
#
#     REDIS_URL=redis://127.0.0.1:6379
#     REDIS_URL=redis://:password@cache.example.com:6379/1
#     REDIS_URL=rediss://:password@cache.example.com:6380
REDIS_URL=

# rediss:// is the encrypted connection and redis:// is the one in the clear,
# the same way smtps and smtp name the two SMTP sessions. On any network this
# process does not own, encryption is the only correct setting: without it the
# password, the session ids and every cached value cross the wire as plain text.
#
# A managed endpoint needs nothing below: its certificate is signed by a public
# authority and the host of the URL is the name that certificate has to carry.
# A self-hosted server needs the authority that signed it, and usually a
# certificate of this client's own, because it asks for one back.
#
# They are paths, and a path that cannot be read stops the boot rather than
# leaving the connection quietly unencrypted.
REDIS_CA_FILE=
REDIS_CERT_FILE=
REDIS_KEY_FILE=
# Only when the certificate's name is not the host of the URL -- an address
# reached through a tunnel, or by IP.
REDIS_TLS_SERVER_NAME=

# --- config/queue.go -------------------------------------------------------
# database keeps jobs in a table of this application's own database, which is
# what makes a job commitable by the same transaction as the row it is about.
QUEUE_CONNECTION=database

# The worker, and the four below are commented out for the reason the pool is:
# leaving a variable out is how the queue component is asked for its own answer,
# and this file is copied into every deployment. Written out here, they would be
# pinned in all of them -- the component's defaults would reach none, and the
# lease in particular would be this file's number rather than one anybody chose.
#
# Uncomment one to override it. The numbers are examples of the shape and not
# the defaults: an example that repeats the default is one nobody can tell from
# a setting somebody chose.
#
# A value that is present and cannot be used stops the boot naming itself. The
# retry is a count of seconds, and it is the lease: a job whose worker died is
# picked up again after it, so the number has to exceed the longest handler or
# the same work runs twice. `aru work --queue` and `--workers` override the
# first two for one invocation.
#QUEUE_DEFAULT=default
#QUEUE_WORKERS=8
#QUEUE_RETRY_AFTER=300
#QUEUE_MAX_ATTEMPTS=3

# --- config/filesystems.go -------------------------------------------------
# local, r2 or s3. R2 first: the S3 protocol without the egress bill.
FILESYSTEM_DISK=local
FILESYSTEM_ROOT=storage/app/private
FILESYSTEM_BUCKET=
FILESYSTEM_ENDPOINT=
FILESYSTEM_REGION=auto
FILESYSTEM_ACCESS_KEY_ID=
FILESYSTEM_SECRET_ACCESS_KEY=

# --- config/mail.go --------------------------------------------------------
# log writes the message instead of sending it, which is the right default on a
# laptop: a framework that sends real mail from a development machine is a
# framework that mails a customer during a test.
MAIL_URL=log://





MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=

# --- config/services.go ----------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
POSTMARK_SERVER_TOKEN=

# --- observability ---------------------------------------------------------
# Enables the request Collector outside development, for requests carrying this
# value in X-Arandu-Trace. Leave empty in production unless you are tracing.
ARANDU_TRACING_SECRET=

# Target of the "open in editor" links on the error page: vscode, cursor, goland, zed.
ARANDU_EDITOR=vscode
