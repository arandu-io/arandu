{
  // Kyse sources remain visible while the generated Go views stay out of search.
  "files.associations": {
    "*.kyse.go": "kyse"
  },
  "[kyse]": {
    "editor.formatOnSave": false
  },
  "search.exclude": {
    "storage/framework/views/**": true
  },

  // The compiled stylesheet is build output too. It is committed -- the assets
  // package embeds it, so a binary built without it serves nothing -- but it is
  // not a file anybody reads.
  "files.exclude": {
    "assets/app.css": true
  }
}
