{
  // The generated views are not here to hide any more: they are build output
  // and .gitignore keeps them out of the tree (see resources/views there).
  //
  // A .kyse.go is Go with markup in it, and the Go extension would report the
  // markup as a syntax error on every keystroke. The build tag already excludes
  // it from the compiler; this excludes it from the language server.
  "gopls": {
    "build.buildFlags": []
  },

  // The compiled stylesheet is build output too. It is committed -- the assets
  // package embeds it, so a binary built without it serves nothing -- but it is
  // not a file anybody reads.
  "files.exclude": {
    "assets/app.css": true
  }
}
